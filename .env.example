# Copy to .env for local use (optional). On Render, set these in the dashboard.
# PORT is set automatically by Render — do not hardcode it in code.

# Set to "true" only if you want fake demo users (Superman/Goku) on the online list.
# Leave unset or "false" for production / live site.
ENABLE_DEMO_USERS=false

# --- Email (required for real account verification) ---
# Option A: Resend (recommended) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=PineappleChat <onboarding@resend.dev>

# Option B: SMTP (Gmail app password, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=PineappleChat <you@gmail.com>

# Local testing only — shows the code in the UI if email is not configured.
# Never set this to true on the live site.
ALLOW_DEV_CODES=false

# Owner account (full member list + unlimited inbox messages)
OWNER_EMAIL=instabusiness8801@gmail.com
